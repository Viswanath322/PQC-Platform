# Copy this file to .env for local development. Keep .env out of Git.
APP_ENV=development
DATABASE_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
# Match the password in the repository-root .env used by Docker Compose.
# For Memurai without a password, use redis://127.0.0.1:6379/0
REDIS_URL=
UPLOAD_DIR=storage/uploads
