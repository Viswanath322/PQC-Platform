# Copy this file to .env for local development. Keep .env out of Git.
APP_ENV=development
DATABASE_URL=mysql+pymysql://pqc:change_me_locally@127.0.0.1:3306/pqc_security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost
REDIS_URL=redis://:redis_change_me_locally@127.0.0.1:6379/0
UPLOAD_DIR=storage/uploads
