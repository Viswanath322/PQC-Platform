# ==============================================================================
# PQC Security Assessment Platform - Environment Configuration Template
# Copy this file to .env:
#   Windows:  copy .env.example .env
#   Linux/Mac: cp .env.example .env
# ==============================================================================

# Application Environment (development | testing | production)
APP_ENV=development

# ------------------------------------------------------------------------------
# MySQL Database Configuration
# ------------------------------------------------------------------------------
# Used by docker-compose.yml to bootstrap the MySQL 8 container
MYSQL_DATABASE=pqc_security
MYSQL_USER=pqc
MYSQL_PASSWORD=pqc_dev_pass_123
MYSQL_ROOT_PASSWORD=pqc_root_dev_pass_123

# SQLAlchemy connection string used by FastAPI backend and workers
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=mysql+pymysql://pqc:pqc_dev_pass_123@127.0.0.1:3306/pqc_security

# ------------------------------------------------------------------------------
# Redis Queue & Broker Configuration
# ------------------------------------------------------------------------------
# Used by docker-compose.yml to secure Redis 7
REDIS_PASSWORD=pqc_redis_pass_123

# Redis connection string used by backend and scan worker
# Format: redis://:<password>@<host>:<port>/<db_index>
REDIS_URL=redis://:pqc_redis_pass_123@127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# Authentication & Security Tokens
# ------------------------------------------------------------------------------
# Must be at least 32 characters long. Replace with a unique random secret in production.
# Generate new: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=pqc_dev_jwt_secret_token_9472fba73c18b450e1847629b3d1685a
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Allowed CORS origins for local web development and desktop client
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost,http://tauri.localhost

# ------------------------------------------------------------------------------
# Storage Directory
# ------------------------------------------------------------------------------
# Directory where uploaded repository ZIP archives and extracted files are stored
UPLOAD_DIR=storage/uploads

